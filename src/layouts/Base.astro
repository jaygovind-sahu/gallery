---
import { env } from 'cloudflare:workers';
import '../styles/global.css';
import NavMenuItem from '../components/NavMenuItem.astro';
import type { PublicNav } from '../lib/db';
import { siteOrigin } from '../lib/host';

interface Props {
  title: string;
  description?: string;
  /**
   * Categories with published photos, the Miscellaneous count and the total, for the header and footer menus.
   * Null on the walk-through, whose header shows only the site name: categories are chosen in the grid.
   */
  nav: PublicNav | null;
  /** Slug of the current category ("miscellaneous" for photos in none, "all" for All), for the menus. */
  activeSlug?: string;
  /** Absolute URL, pixel size and alt text of the preview image for shared links. */
  ogImage?: { url: string; width: number; height: number; alt: string } | null;
  /** False on pages that shouldn't name a canonical URL (the 404 page). */
  canonical?: boolean;
  /**
   * Full-viewport pages (the walk-through): no footer, no page scroll, `main` is an unpadded positioned box,
   * and the header floats over it with a transparent background.
   */
  immersive?: boolean;
  /** `light` inverts the tokens in the header (`.tone-light`), for pages drawn on a light scene. */
  tone?: 'dark' | 'light';
}

const {
  title,
  description = 'Photography by Jaygovind Sahu: birds, macro, landscape and astro.',
  nav,
  activeSlug,
  ogImage = null,
  canonical = true,
  immersive = false,
  tone = 'dark',
} = Astro.props;

const pageUrl = siteOrigin(env.SITE_URL, Astro.url.origin) + Astro.url.pathname;

// Empty categories are already left out of `nav`; Miscellaneous shows only while some photo is in no category.
const menu = (nav?.categories ?? []).map((c) => ({ href: `/c/${c.slug}`, label: c.name, slug: c.slug, count: c.photoCount }));
const misc = nav && nav.miscCount > 0 ? { href: '/c/miscellaneous', label: 'Miscellaneous', slug: 'miscellaneous', count: nav.miscCount } : null;
const hasMenu = menu.length > 0 || misc !== null;
const inCategories = activeSlug !== undefined && activeSlug !== 'all';
const footerLinks = [...menu, ...(misc ? [misc] : []), { href: '/all', label: 'All', slug: 'all' }];
const hasHeaderEnd = Astro.slots.has('header-end');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={tone === 'light' ? '#e4e0d9' : '#0f0f10'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={pageUrl} />}
    <meta property="og:site_name" content="Jay’s Gallery" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={pageUrl} />}
    {
      ogImage ? (
        <>
          <meta property="og:image" content={ogImage.url} />
          <meta property="og:image:width" content={String(ogImage.width)} />
          <meta property="og:image:height" content={String(ogImage.height)} />
          <meta property="og:image:alt" content={ogImage.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      ) : (
        <meta name="twitter:card" content="summary" />
      )
    }
  </head>
  <body class:list={['flex flex-col', immersive ? 'h-dvh overflow-hidden' : 'min-h-screen']}>
    <header
      id="site-header"
      class:list={[
        'site-header z-10 flex items-center justify-between gap-4 px-4 py-4 sm:px-8 sm:py-5',
        immersive ? 'site-header--overlay absolute inset-x-0 top-0' : 'sticky top-0',
        tone === 'light' && 'tone-light',
      ]}
    >
      <a href="/" class="shrink-0 font-display text-[26px] font-medium leading-none tracking-[0.01em] text-ink">Jay’s Gallery</a>
      <div class="flex items-center gap-3 sm:gap-6">
        {nav && (
          <nav aria-label="Main" class="hidden items-center gap-6 text-sm sm:flex">
            {
              hasMenu && (
                <details class="nav-menu relative" data-menu>
                  <summary class="nav-link flex cursor-pointer list-none items-center gap-1.5 [&::-webkit-details-marker]:hidden" data-active={inCategories ? '' : undefined}>
                    Categories
                    <svg class="nav-menu__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M6 9l6 6 6-6" />
                    </svg>
                  </summary>
                  <div class="absolute -left-4 top-full z-20 mt-3.5 flex w-[260px] flex-col rounded-lg border border-divider bg-surface py-2 text-[15px]">
                    {menu.map((l) => <NavMenuItem href={l.href} label={l.label} count={l.count} current={l.slug === activeSlug} />)}
                    {misc && menu.length > 0 && <span class="mx-4 my-2 h-px bg-divider" aria-hidden="true" />}
                    {misc && <NavMenuItem href={misc.href} label={misc.label} count={misc.count} current={activeSlug === misc.slug} />}
                  </div>
                </details>
              )
            }
            <a href="/all" aria-current={activeSlug === 'all' ? 'page' : undefined} class="nav-link">
              All
            </a>
          </nav>
        )}
        {nav && hasHeaderEnd && <span class="hidden h-5 w-px bg-divider sm:block" aria-hidden="true" />}
        {hasHeaderEnd && <slot name="header-end" />}
        {nav && (
          <details class="relative sm:hidden" data-menu>
            <summary class="flex cursor-pointer list-none items-center rounded-full p-1.5 text-ink-muted hover:text-ink [&::-webkit-details-marker]:hidden" aria-label="Menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <path d="M4 8h16M4 16h16" />
              </svg>
            </summary>
            <nav aria-label="Categories" class="absolute right-0 top-full z-20 mt-3 flex w-[250px] flex-col rounded-lg border border-divider bg-surface py-2 text-[15px]">
              {menu.map((l) => <NavMenuItem href={l.href} label={l.label} count={l.count} current={l.slug === activeSlug} />)}
              {menu.length > 0 && <span class="mx-4 my-2 h-px bg-divider" aria-hidden="true" />}
              {misc && <NavMenuItem href={misc.href} label={misc.label} count={misc.count} current={activeSlug === misc.slug} />}
              <NavMenuItem href="/all" label="All photos" count={nav.allCount} current={activeSlug === 'all'} />
            </nav>
          </details>
        )}
      </div>
    </header>

    <main class:list={immersive ? 'relative min-h-0 flex-1' : 'flex-1 px-4 sm:px-8'}>
      <slot />
    </main>

    {!immersive && (
      <footer class="mt-16 px-4 sm:mt-24 sm:px-8">
        <div class="flex flex-col gap-6 border-t border-divider pb-10 pt-8 sm:flex-row sm:items-start sm:justify-between">
          <div class="flex flex-col gap-2">
            <a href="/" class="self-start font-display text-[21px] font-medium leading-none tracking-[0.01em] text-ink">Jay’s Gallery</a>
            <p class="m-0 text-xs text-ink-muted">© {year} Jaygovind Sahu</p>
          </div>
          <div class="flex flex-col gap-3 text-[13px] sm:items-end">
            <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
              {
                footerLinks.map((l) => (
                  <a href={l.href} aria-current={l.slug === activeSlug ? 'page' : undefined} class="footer-link">
                    {l.label}
                  </a>
                ))
              }
            </nav>
            <a href="https://jaygovindsahu.com" class="footer-link inline-flex items-center gap-1">
              jaygovindsahu.com
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7M8 7h9v9" />
              </svg>
            </a>
          </div>
        </div>
      </footer>
    )}

    <script>
      // Slim sticky header: hides on scroll down, returns on scroll up.
      const header = document.getElementById('site-header');

      // The category menus are <details>: close them on a click outside or on Escape.
      const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details[data-menu]'));
      document.addEventListener('click', (event) => {
        for (const menu of menus) if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
      });
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      let last = window.scrollY;
      header?.toggleAttribute('data-scrolled', last > 8);
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking || !header) return;
          ticking = true;
          requestAnimationFrame(() => {
            const y = window.scrollY;
            header.toggleAttribute('data-scrolled', y > 8);
            const menuOpen = header.querySelector('details[open]');
            if (y > last && y > 80 && !menuOpen) header.classList.add('-translate-y-full');
            else if (y < last) header.classList.remove('-translate-y-full');
            last = y;
            ticking = false;
          });
        },
        { passive: true },
      );
    </script>
  </body>
</html>

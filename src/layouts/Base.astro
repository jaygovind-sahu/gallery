---
import '../styles/global.css';
import type { Category } from '../lib/db';

interface Props {
  title: string;
  description?: string;
  categories: Category[];
  /** Slug of the current category, for aria-current in the menu. */
  activeSlug?: string;
}

const { title, description = 'Photography by Jaygovind Sahu: birds, macro, landscape and astro.', categories, activeSlug } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f0f10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen">
    <header class="sticky top-0 z-10 flex items-center justify-between gap-6 bg-bg px-4 py-4 sm:px-8 sm:py-5">
      <a href="/" class="font-serif text-[22px] tracking-[0.01em] text-ink">Jaygovind Sahu</a>
      <nav aria-label="Categories" class="hidden gap-6 text-sm sm:flex">
        {
          categories.map((c) => (
            <a
              href={`/c/${c.slug}`}
              aria-current={c.slug === activeSlug ? 'page' : undefined}
              class:list={['transition-colors hover:text-ink', c.slug === activeSlug ? 'text-ink' : 'text-ink-muted']}
            >
              {c.name}
            </a>
          ))
        }
        <a href="/all" class="text-ink-muted transition-colors hover:text-ink">All</a>
      </nav>
    </header>

    <main class="px-4 sm:px-8">
      <slot />
    </main>

    <footer class="flex items-center justify-between gap-4 px-4 pb-10 pt-14 text-xs text-ink-muted sm:px-8">
      <span>© Jaygovind Sahu</span>
      <a href="https://jaygovindsahu.com" class="hover:text-ink">jaygovindsahu.com</a>
    </footer>
  </body>
</html>

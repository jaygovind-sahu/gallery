---
// Not found: any unknown URL, and public pages that return an empty 404 (unknown slug, draft or missing photo).
// The wording is the same in every case, so it never tells a draft apart from a photo that doesn't exist.
import Base from '../layouts/Base.astro';
import { getPublicNav, type PublicNav } from '../lib/db';

const nav: PublicNav = await getPublicNav().catch(() => ({ categories: [], miscCount: 0, allCount: 0 }));
---

<Base title="Not found — Jay’s Gallery" nav={nav} canonical={false}>
  <div class="flex flex-col gap-3 pb-8 pt-20 sm:pt-28">
    <p class="eyebrow m-0">Not found</p>
    <h1 class="m-0 font-display text-[42px] font-medium leading-[1.05] tracking-[0.01em] text-ink sm:text-[48px]">Nothing here</h1>
    <p class="m-0 max-w-[52ch] text-pretty text-[15px] leading-relaxed text-ink-muted">
      There's no photo or page at this address. It may have moved, or it's no longer published.
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-5 text-sm">
      <a href="/" class="rounded-full border border-divider px-4 py-2 text-ink transition-colors hover:border-ink-muted">Latest photos</a>
      <a href="/all" class="footer-link">All photos</a>
    </div>
  </div>
</Base>

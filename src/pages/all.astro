---
// Every published photo, by sort_order.
import GalleryPage from '../components/gallery/GalleryPage.astro';
import { getPublicNav, getSetting, listAllPhotos } from '../lib/db';
import { isLayout } from '../lib/gallery';

const [nav, defaultSetting, photos] = await Promise.all([getPublicNav(), getSetting('default_layout'), listAllPhotos()]);
const defaultLayout = isLayout(defaultSetting) ? defaultSetting : 'rows';
const count = `${photos.length} ${photos.length === 1 ? 'photo' : 'photos'}`;
---

<GalleryPage
  title="All photos — Jay’s Gallery"
  nav={nav}
  activeSlug="all"
  heading="All photos"
  eyebrow={count}
  photos={photos}
  defaultLayout={defaultLayout}
  galleryUrl="/all"
/>

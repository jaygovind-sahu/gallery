---
import Admin from '../../../layouts/Admin.astro';
import PhotoForm from '../../../components/admin/PhotoForm';
import { aiEnabled } from '../../../lib/ai';
import { getAdminPhoto, listCategories, listLocations } from '../../../lib/db';

const id = Astro.params.id ?? '';
const [photo, categories, locations] = await Promise.all([getAdminPhoto(id), listCategories(), listLocations()]);
if (!photo) return new Response('Not found', { status: 404 });

const heading = photo.title || photo.originalFilename || 'Untitled';
---

<Admin title={heading} current="library">
  <div class="flex flex-col gap-1 pb-6">
    <a href="/admin" class="text-xs text-ink-muted hover:text-ink">← Library</a>
    <h1 class="m-0 truncate font-serif text-3xl font-normal text-ink">{heading}</h1>
  </div>
  <PhotoForm
    client:load
    photo={photo}
    categories={categories.map((c) => ({ id: c.id, name: c.name }))}
    locations={locations.map((l) => ({ id: l.id, name: l.name }))}
    aiEnabled={aiEnabled(Astro.url)}
  />
</Admin>

---
import Admin from '../../../layouts/Admin.astro';
import CategoryManager from '../../../components/admin/CategoryManager';
import { listAdminCategories } from '../../../lib/db';

const categories = await listAdminCategories();
---

<Admin title="Categories" current="categories">
  <h1 class="m-0 pb-6 font-display text-4xl font-medium text-ink">Categories</h1>
  <CategoryManager client:load categories={categories} />
</Admin>

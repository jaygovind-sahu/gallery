---
import Admin from '../../layouts/Admin.astro';
import Library from '../../components/admin/Library';
import { listAdminPhotos, listCategories, listLocations } from '../../lib/db';

const q = Astro.url.searchParams;
const statusParam = q.get('status');
const filter = {
  category: q.get('category') ?? '',
  location: q.get('location') ?? '',
  status: (statusParam === 'published' || statusParam === 'draft' || statusParam === 'uploading' ? statusParam : '') as
    | ''
    | 'published'
    | 'draft'
    | 'uploading',
};

const [photos, categories, locations] = await Promise.all([
  listAdminPhotos({ categoryId: filter.category || undefined, locationId: filter.location || undefined, status: filter.status || undefined }),
  listCategories(),
  listLocations(),
]);
---

<Admin title="Library" current="library">
  <div class="flex items-baseline justify-between gap-4 pb-6">
    <h1 class="m-0 font-serif text-3xl font-normal text-ink">Library</h1>
    <a href="/admin/upload" class="text-sm text-ink-muted hover:text-ink">Upload →</a>
  </div>
  <Library
    client:load
    photos={photos}
    categories={categories.map((c) => ({ id: c.id, name: c.name }))}
    locations={locations.map((l) => ({ id: l.id, name: l.name }))}
    filter={filter}
  />
</Admin>

---
// One category in its manual order, in the owner's default layout for it.
import GalleryPage from '../../components/gallery/GalleryPage.astro';
import { getCategoryBySlug, getPublicCoverPhotoId, getPublicNav, listCategoryPhotos } from '../../lib/db';

const slug = Astro.params.slug ?? '';
const [category, nav] = await Promise.all([getCategoryBySlug(slug), getPublicNav()]);
// An empty 404 renders src/pages/404.astro.
if (!category) return new Response(null, { status: 404 });

const [photos, coverId] = await Promise.all([listCategoryPhotos(category.id), getPublicCoverPhotoId(category.id)]);
// Shared links preview the cover the owner chose, else the first photo.
const countLabel = `${category.photoCount} ${category.photoCount === 1 ? 'photo' : 'photos'}`;
---

<GalleryPage
  title={`${category.name} — Jay’s Gallery`}
  description={category.description ?? undefined}
  nav={nav}
  activeSlug={category.slug}
  heading={category.name}
  eyebrow={countLabel}
  subline={category.description}
  photos={photos}
  defaultLayout={category.defaultLayout}
  galleryUrl={`/c/${category.slug}`}
  contextCategory={category.name}
  ogPhoto={photos.find((p) => p.id === coverId) ?? photos[0] ?? null}
/>

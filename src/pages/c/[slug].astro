---
// One category in its manual order, in the owner's default layout for it.
import GalleryPage from '../../components/gallery/GalleryPage.astro';
import { getCategoryBySlug, listCategories, listCategoryPhotos } from '../../lib/db';

const slug = Astro.params.slug ?? '';
const [category, categories] = await Promise.all([getCategoryBySlug(slug), listCategories()]);
if (!category) return new Response('Not found', { status: 404 });

const photos = await listCategoryPhotos(category.id);
const countLabel = `${category.photoCount} ${category.photoCount === 1 ? 'photo' : 'photos'}`;
---

<GalleryPage
  title={`${category.name} — Jaygovind Sahu`}
  description={category.description ?? undefined}
  categories={categories}
  activeSlug={category.slug}
  heading={category.name}
  subline={`${countLabel}${category.description ? ` · ${category.description}` : ''}`}
  photos={photos}
  defaultLayout={category.defaultLayout}
  galleryUrl={`/c/${category.slug}`}
  contextCategory={category.name}
/>

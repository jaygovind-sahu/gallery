---
// Every published photo at a location, newest first.
import GalleryPage from '../../components/gallery/GalleryPage.astro';
import { getPublicLocationBySlug, getPublicNav, getSetting, listLocationPhotos } from '../../lib/db';
import { isLayout } from '../../lib/gallery';

const slug = Astro.params.slug ?? '';
const [location, nav, defaultSetting] = await Promise.all([getPublicLocationBySlug(slug), getPublicNav(), getSetting('default_layout')]);
// An empty 404 renders src/pages/404.astro.
if (!location) return new Response(null, { status: 404 });

const photos = await listLocationPhotos(location.id);
const defaultLayout = isLayout(defaultSetting) ? defaultSetting : 'rows';
const countLabel = `${location.photoCount} ${location.photoCount === 1 ? 'photo' : 'photos'}`;
---

<GalleryPage
  title={`${location.name} — Jay’s Gallery`}
  description={`Photos from ${location.name}${location.region ? `, ${location.region}` : ''}, by Jaygovind Sahu.`}
  nav={nav}
  heading={location.name}
  eyebrow={location.region ? `${location.region} · ${countLabel}` : countLabel}
  photos={photos}
  defaultLayout={defaultLayout}
  galleryUrl={`/l/${location.slug}`}
/>

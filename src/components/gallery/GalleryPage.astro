---
/**
 * Shared shell for every public gallery page: Base layout with the layout toggle in the header,
 * an optional title block, then the Gallery island.
 */
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import type { PublicNav, PublicPhoto } from '../../lib/db';
import { altText, derivativeDimensions, resolveLayout, type Layout } from '../../lib/gallery';
import { siteOrigin } from '../../lib/host';
import { imageUrl } from '../../lib/images';
import Gallery from './Gallery';
import LayoutToggle from './LayoutToggle';

interface Props {
  title: string;
  description?: string;
  nav: PublicNav;
  activeSlug?: string;
  heading?: string;
  /** Permalink pages put the photo title in the h1 and show the category name as an h2. */
  headingTag?: 'h1' | 'h2';
  /** Small caps line above the heading: the photo count, plus the region on location pages. */
  eyebrow?: string | null;
  /** One line of secondary text under the heading (a category's description). */
  subline?: string | null;
  photos: PublicPhoto[];
  defaultLayout: Layout;
  galleryUrl: string;
  initialPhotoId?: string | null;
  contextCategory?: string | null;
  /** The photo shared links preview, at 1600 px. Defaults to the first photo on the page. */
  ogPhoto?: PublicPhoto | null;
}

const { title, description, nav, activeSlug, heading, headingTag = 'h1', eyebrow, subline, photos, defaultLayout, galleryUrl, initialPhotoId = null, contextCategory = null, ogPhoto } = Astro.props;
const initialLayout = resolveLayout(Astro.url.searchParams.get('layout'), null, defaultLayout);
const preview = ogPhoto === undefined ? (photos[0] ?? null) : ogPhoto;
const ogImage = preview
  ? {
      url: siteOrigin(env.SITE_URL, Astro.url.origin) + imageUrl(preview.id, preview.version, 1600),
      ...derivativeDimensions(preview.width, preview.height, 1600),
      alt: altText(preview, contextCategory),
    }
  : null;
---

<Base title={title} description={description} nav={nav} activeSlug={activeSlug} ogImage={ogImage}>
  <div slot="header-end" class="flex items-center gap-2">
    <LayoutToggle client:load fallback={defaultLayout} initial={initialLayout} />
    {/* The walk-through: every published photo as one room; categories are chosen here, in the grid. */}
    <a href="/walk" class="walk-link" title="Walk through the gallery">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.75" y="3.75" width="16.5" height="16.5" rx="1.25" />
        <path d="M9.5 9h5v6h-5zM3.75 3.75 9.5 9M20.25 3.75 14.5 9M3.75 20.25 9.5 15M20.25 20.25 14.5 15" />
      </svg>
      <span class="hidden sm:inline">Walk</span>
      <span class="sr-only sm:hidden">Walk through the gallery</span>
    </a>
  </div>
  {
    heading ? (
      <div class="flex flex-col gap-3 pb-10 pt-14 sm:pb-12 sm:pt-20">
        {eyebrow && <p class="eyebrow m-0">{eyebrow}</p>}
        {
          headingTag === 'h1' ? (
            <h1 class="m-0 font-display text-[42px] font-medium leading-[1.05] tracking-[0.01em] text-ink sm:text-[48px]">{heading}</h1>
          ) : (
            <h2 class="m-0 font-display text-[42px] font-medium leading-[1.05] tracking-[0.01em] text-ink sm:text-[48px]">{heading}</h2>
          )
        }
        {subline && <p class="m-0 max-w-[60ch] text-pretty text-[15px] leading-relaxed text-ink-muted">{subline}</p>}
      </div>
    ) : (
      <div class="pt-4 sm:pt-6" />
    )
  }
  <slot />
  <Gallery client:load photos={photos} initialLayout={initialLayout} defaultLayout={defaultLayout} galleryUrl={galleryUrl} initialPhotoId={initialPhotoId} contextCategory={contextCategory} />
</Base>

---
/** One row of the header's category menus: the name, a dot when it's the current page, the photo count. */
interface Props {
  href: string;
  label: string;
  count?: number;
  current: boolean;
}

const { href, label, count, current } = Astro.props;
---

<a
  href={href}
  aria-current={current ? 'page' : undefined}
  class:list={['flex items-center justify-between gap-4 px-4 py-2.5 transition-colors hover:text-ink', current ? 'text-ink' : 'text-ink-muted']}
>
  <span class="flex min-w-0 items-center gap-2">
    <span class="truncate">{label}</span>
    {current && <span class="size-1.5 shrink-0 rounded-full bg-ink" aria-hidden="true" />}
  </span>
  {count !== undefined && <span class="shrink-0 text-[13px] tabular-nums text-ink-muted">{count}</span>}
</a>

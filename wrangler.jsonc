{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gallery",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Private bucket for full-resolution originals. Never give it public access.
  "r2_buckets": [{ "binding": "ORIGINALS", "bucket_name": "gallery-originals" }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gallery-db",
      "database_id": "5d6ee36d-fd6a-4f9f-8204-a6519fd13947",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Images binding: resizes originals and draws the watermark.
  "images": { "binding": "IMAGES" },

  // Creates the DNS record for the subdomain on deploy.
  "routes": [{ "pattern": "gallery.jaygovindsahu.com", "custom_domain": true }],
  // Serve only on the custom domain, where Access sits in front of /admin: no workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,

  // Public, non-secret settings. OWNER_EMAIL is a secret, kept in GitHub and sent with each deploy (wiki/deploy.md).
  "vars": {
    "SITE_URL": "https://gallery.jaygovindsahu.com",
    "ACCESS_TEAM_DOMAIN": "blue-shadow-d31f.cloudflareaccess.com",
    "ACCESS_AUD": "b97cb6cfa779e4f255dbb60f4e6724cc18e473bd0d52740fdf3ea9b205a69b8d",
    // AI suggestions: which model each provider runs. The API keys (ANTHROPIC_API_KEY, OPENAI_API_KEY) are
    // secrets, kept in GitHub like OWNER_EMAIL.
    "ANTHROPIC_MODEL": "claude-sonnet-5-5",
    "OPENAI_MODEL": "gpt-5-mini",
    "OPENAI_REASONING_EFFORT": "low"
  },

  "observability": { "enabled": true },

  "env": {
    // Local dev against the live bucket and database: `pnpm dev:live` (CLOUDFLARE_ENV=live). Never deployed;
    // no routes and no workers.dev URL so a stray `--env live` deploy can't claim the domain.
    // Bindings and vars don't inherit into an env, so they're repeated here: keep them in sync with the top level.
    "live": {
      "routes": [],
      "workers_dev": false,
      "r2_buckets": [{ "binding": "ORIGINALS", "bucket_name": "gallery-originals", "remote": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gallery-db",
          "database_id": "5d6ee36d-fd6a-4f9f-8204-a6519fd13947",
          "migrations_dir": "migrations",
          "remote": true
        }
      ],
      "images": { "binding": "IMAGES" },
      "vars": {
        "SITE_URL": "https://gallery.jaygovindsahu.com",
        "ACCESS_TEAM_DOMAIN": "blue-shadow-d31f.cloudflareaccess.com",
        "ACCESS_AUD": "b97cb6cfa779e4f255dbb60f4e6724cc18e473bd0d52740fdf3ea9b205a69b8d",
        "ANTHROPIC_MODEL": "claude-sonnet-5-5",
        "OPENAI_MODEL": "gpt-5-mini",
        "OPENAI_REASONING_EFFORT": "low"
      }
    }
  }
}
